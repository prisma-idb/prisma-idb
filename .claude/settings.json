{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm test:*)",
      "Bash(pnpm check)",
      "Bash(pnpm check:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm build)",
      "Bash(pnpm build *)",
      "Bash(pnpm generate)",
      "Bash(pnpm agents:*)",
      "Bash(pnpm exec turbo run *)",
      "Bash(pnpm exec prettier --check *)",
      "Bash(pnpm --filter * test)",
      "Bash(pnpm --filter * test *)",
      "Bash(pnpm --filter * build)",
      "Bash(pnpm --filter * check)",
      "Bash(pnpm --filter * exec vitest run *)",
      "Bash(pnpm changeset status *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)"
    ],
    "deny": ["Read(**/.env)", "Read(**/.env.local)", "Read(**/.env.*.local)", "Bash(npm *)", "Bash(npx *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-generated.mjs\"" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-review.mjs\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\"" }]
      }
    ]
  }
}
