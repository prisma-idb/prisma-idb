{
  "name": "@prisma-idb/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --no-cache",
    "check": "pnpm check:prisma-idb-descriptors && turbo run check",
    "lint": "turbo run lint",
    "format": "turbo run format --no-cache",
    "test": "turbo run test --concurrency 1",
    "test:generator-client": "turbo run test --filter=@prisma-idb/usage",
    "test:generator-sync": "turbo run test --filter=@prisma-idb/kanban-example",
    "test:generator-schema": "turbo run test --filter=@prisma-idb/schema-gen-tests",
    "test:benchmark": "turbo run test --filter=@prisma-idb/benchmark",
    "benchmark:local": "bash scripts/benchmark-local.sh",
    "test:watch": "turbo run test:watch --no-cache",
    "generate": "turbo run generate",
    "clean": "turbo clean && rm -rf node_modules",
    "preview": "turbo run preview",
    "run:ci": "pnpm format && pnpm generate && pnpm lint && pnpm check && pnpm build",
    "prepare": "husky",
    "changeset": "changeset",
    "check:prisma-idb-descriptors": "tsx scripts/check-prisma-idb-descriptor-consistency.ts",
    "test:prisma-idb": "turbo run test --filter=@prisma-idb/adapter-idb --filter=@prisma-idb/client-idb --filter=@prisma-idb/driver-idb --filter=@prisma-idb/family-idb --filter=@prisma-idb/runtime-idb --filter=@prisma-idb/target-idb --filter=@prisma-idb/sync-server --filter=@prisma-idb/sync-server-sql --filter=@prisma-idb/cli-tests --filter=@prisma-idb/sync-extension-idb",
    "test:prisma-idb-e2e": "turbo run test --filter=@prisma-idb/prisma-orm-usage",
    "test:prisma-idb-kanban-e2e": "turbo run test --filter=@prisma-idb/prisma-orm-kanban-example",
    "version:prisma-idb": "changeset version",
    "release:prisma-idb": "pnpm build --filter=\"./packages/prisma-orm/*\" && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "*.{js,ts,svelte,tsx,jsx,mjs}": ["prettier --write", "eslint --fix"],
    "*.{json,md,mdx,css,html,yaml,yml}": ["prettier --write"]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prisma-idb/prisma-idb.git"
  }
}
