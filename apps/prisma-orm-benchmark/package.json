{
  "name": "@prisma-idb/prisma-orm-benchmark",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4176",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4176 --strictPort",
    "test": "PLAYWRIGHT_HTML_OPEN=never playwright test --reporter=list",
    "benchmark:ci": "pnpm test",
    "benchmark:compare": "benchmark-compare",
    "benchmark:comment": "benchmark-comment",
    "check": "tsc --noEmit",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "contract:emit": "prisma contract emit --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma-idb/benchmark-kit": "workspace:*",
    "@prisma-idb/client-idb": "workspace:*",
    "@prisma-idb/family-idb": "workspace:*",
    "@prisma-idb/target-idb": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@prisma-idb/adapter-idb": "workspace:*",
    "@prisma-idb/driver-idb": "workspace:*",
    "@prisma/cli-engine": "0.2.0",
    "@types/node": "^24.13.3",
    "prisma": "8.0.0-rc.7",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
