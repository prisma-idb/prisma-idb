DATABASE_URL="postgres://prisma_idb:prisma_idb@localhost:5433/prisma_idb_kanban"

# Any random 32+ byte value. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-not-for-production-replace-me"

# Optional — silences a startup warning and avoids deriving the origin from
# request headers. Match whatever port you're actually running on
# (`pnpm dev` defaults to 5173, `pnpm preview`/e2e to 4176).
# BETTER_AUTH_URL="http://localhost:5173"

# From a Google Cloud OAuth client (console.cloud.google.com > APIs &
# Services > Credentials > OAuth client ID > Web application). Add
# "{BETTER_AUTH_URL}/api/auth/callback/google" as an authorized redirect URI
# for whatever origin you're actually testing against.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
