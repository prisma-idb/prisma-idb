{
  "name": "@prisma-idb/prisma-orm-kanban-example",
  "private": true,
  "version": "0.0.10",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm contract:emit:postgres && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install",
    "test": "pnpm test:e2e",
    "contract:emit": "prisma contract emit --config prisma.config.ts",
    "contract:emit:postgres": "prisma contract emit --config prisma.config.postgres.ts",
    "migration:plan": "prisma-idb migration plan",
    "migration:contract-space": "prisma-idb migration contract-space",
    "migration:preflight": "prisma-idb migration preflight",
    "migration:postgres:new": "prisma migration new --config prisma.config.postgres.ts",
    "migration:postgres:status": "prisma migration status --config prisma.config.postgres.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:init": "prisma db init --config prisma.config.postgres.ts",
    "db:update": "prisma db update --config prisma.config.postgres.ts"
  },
  "dependencies": {
    "@prisma-idb/client-idb": "workspace:*",
    "@prisma-idb/sync-extension-idb": "workspace:*",
    "@prisma-idb/sync-server": "workspace:*",
    "@prisma-idb/sync-server-sql": "workspace:*",
    "@prisma/orm-framework": "8.0.0-rc.5",
    "@prisma/orm-postgres": "8.0.0-rc.5",
    "@prisma/orm-toolchain": "8.0.0-rc.5",
    "better-auth": "^1.7.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@lucide/svelte": "^1.30.0",
    "@playwright/test": "^1.63.0",
    "@prisma-idb/adapter-idb": "workspace:*",
    "@prisma-idb/driver-idb": "workspace:*",
    "@prisma-idb/family-idb": "workspace:*",
    "@prisma-idb/target-idb": "workspace:*",
    "@prisma/cli-engine": "0.2.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "prisma": "8.0.0-rc.7",
    "shadcn-svelte": "^1.5.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
