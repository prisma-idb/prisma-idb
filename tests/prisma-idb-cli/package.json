{
  "name": "@prisma-idb/cli-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Regression tests for the `prisma-idb` CLI binary (migration plan/contract-space/preflight, config-driven path resolution). Drives the published binary via execa and asserts on stdout/stderr/exit codes/files.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@prisma-idb/adapter-idb": "workspace:*",
    "@prisma-idb/driver-idb": "workspace:*",
    "@prisma-idb/family-idb": "workspace:*",
    "@prisma-idb/sync-server": "workspace:*",
    "@prisma-idb/sync-server-sql": "workspace:*",
    "@prisma-idb/target-idb": "workspace:*",
    "@prisma/cli-engine": "0.10.0",
    "@prisma/orm-postgres": "8.0.0-rc.24",
    "@prisma/orm-toolchain": "8.0.0-rc.24",
    "@types/node": "^24.13.3",
    "execa": "^10.0.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
