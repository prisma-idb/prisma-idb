{
  "name": "@prisma-idb/benchmark-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Shared benchmark runner, stats and CI regression-gate scripts for the benchmark apps",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "bin": {
    "benchmark-compare": "./src/cli/compare-benchmark-results.ts",
    "benchmark-comment": "./src/cli/publish-benchmark-pr-comment.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "tsx": "^4.23.11"
  }
}
