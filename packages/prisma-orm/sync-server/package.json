{
  "name": "@prisma-idb/sync-server",
  "version": "0.3.1",
  "description": "Prisma 8 IDB — sync ownership DAG (server-side push authorization + pull scoping, ADR 014)",
  "license": "MIT",
  "files": ["dist"],
  "keywords": ["prisma", "prisma-8", "indexeddb", "offline-first", "idb", "sync", "authorization"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prisma-idb/prisma-idb.git",
    "directory": "packages/prisma-orm/sync-server"
  },
  "homepage": "https://prisma-idb.dev/",
  "bugs": {
    "url": "https://github.com/prisma-idb/prisma-idb/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.mts",
      "default": "./dist/schema.mjs"
    },
    "./postgres": {
      "types": "./dist/postgres.d.mts",
      "default": "./dist/postgres.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma-idb/family-idb": "workspace:*",
    "@prisma/orm-family-sql": "8.0.0-rc.5",
    "@prisma/orm-framework": "8.0.0-rc.5",
    "@prisma/orm-postgres": "8.0.0-rc.5"
  },
  "devDependencies": {
    "@prisma-idb/target-idb": "workspace:*",
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
