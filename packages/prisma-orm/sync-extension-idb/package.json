{
  "name": "@prisma-idb/sync-extension-idb",
  "version": "0.3.2",
  "description": "Prisma 8 IDB — outbox sync extension (ORM wrapper, SyncWorker, push/pull client logic)",
  "license": "MIT",
  "files": ["dist"],
  "keywords": ["prisma", "prisma-8", "indexeddb", "offline-first", "idb", "sync", "outbox"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prisma-idb/prisma-idb.git",
    "directory": "packages/prisma-orm/sync-extension-idb"
  },
  "homepage": "https://prisma-idb.dev/",
  "bugs": {
    "url": "https://github.com/prisma-idb/prisma-idb/issues"
  },
  "type": "module",
  "exports": {
    "./control": {
      "types": "./dist/control.d.mts",
      "default": "./dist/control.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    },
    "./schemas": {
      "types": "./dist/schemas.d.mts",
      "default": "./dist/schemas.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "contract:emit": "prisma contract emit --config prisma.config.ts",
    "migration:plan": "prisma-idb migration plan --space idb-sync"
  },
  "dependencies": {
    "@prisma-idb/adapter-idb": "workspace:*",
    "@prisma-idb/client-idb": "workspace:*",
    "@prisma-idb/driver-idb": "workspace:*",
    "@prisma-idb/family-idb": "workspace:*",
    "@prisma-idb/runtime-idb": "workspace:*",
    "@prisma-idb/target-idb": "workspace:*",
    "@prisma/orm-framework": "8.0.0-rc.5",
    "@prisma/orm-toolchain": "8.0.0-rc.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.2.0",
    "@types/node": "^24.13.3",
    "fake-indexeddb": "^6.2.5",
    "prisma": "8.0.0-rc.7",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
