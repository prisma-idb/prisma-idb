{
  "name": "@prisma-idb/client-idb",
  "version": "0.6.0",
  "description": "Prisma 8 IDB family — ORM client (idbOrm typed query builder)",
  "license": "MIT",
  "files": ["dist"],
  "keywords": ["prisma", "prisma-8", "indexeddb", "offline-first", "idb", "orm"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prisma-idb/prisma-idb.git",
    "directory": "packages/prisma-orm/client-idb"
  },
  "homepage": "https://prisma-idb.dev/",
  "bugs": {
    "url": "https://github.com/prisma-idb/prisma-idb/issues"
  },
  "type": "module",
  "exports": {
    "./orm": "./dist/orm.mjs",
    "./client": "./dist/client.mjs",
    "./client-auto": "./dist/client-auto.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma-idb/adapter-idb": "workspace:*",
    "@prisma-idb/driver-idb": "workspace:*",
    "@prisma-idb/runtime-idb": "workspace:*",
    "@prisma-idb/target-idb": "workspace:*",
    "@prisma/orm-framework": "8.0.0-rc.5"
  },
  "devDependencies": {
    "@prisma-idb/family-idb": "workspace:*",
    "@prisma/cli-engine": "0.2.0",
    "@prisma/orm-toolchain": "8.0.0-rc.5",
    "fake-indexeddb": "^6.2.5",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
