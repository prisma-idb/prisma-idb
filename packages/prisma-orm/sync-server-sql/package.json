{
  "name": "@prisma-idb/sync-server-sql",
  "version": "0.2.5",
  "description": "Prisma 8 IDB — SQL execution adapter for sync-server (ownership checks + push/pull against a Prisma 8 SQL ORM client)",
  "license": "MIT",
  "files": ["dist"],
  "keywords": ["prisma", "prisma-8", "indexeddb", "offline-first", "idb", "sync", "sql", "postgres", "sqlite"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prisma-idb/prisma-idb.git",
    "directory": "packages/prisma-orm/sync-server-sql"
  },
  "homepage": "https://prisma-idb.dev/",
  "bugs": {
    "url": "https://github.com/prisma-idb/prisma-idb/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check": "pnpm contract:emit:postgres && tsc --noEmit",
    "test": "pnpm contract:emit:postgres && pnpm db:create && pnpm db:init && vitest run",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "contract:emit:postgres": "prisma contract emit --config prisma.config.ts",
    "db:create": "node scripts/ensure-test-db.mjs",
    "db:init": "prisma db init --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma-idb/sync-server": "workspace:*",
    "@prisma/orm-framework": "8.0.0-rc.5"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.2.0",
    "@prisma/orm-postgres": "8.0.0-rc.5",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "prisma": "8.0.0-rc.7",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
