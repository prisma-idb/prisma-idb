// Minimal fixture schema for this package's integration suite: User (root)
// <- Board (ownerId) <- Todo (boardId) — the same shape the old
// fakeSqlContract() hand-authored, now a real schema a real Postgres
// contract gets emitted from. `writeSqlSchemaWithSync` (see
// ../../prisma.config.ts) appends the synthetic `Changelog` model.
model User {
  id               String            @id
  name             String
  boards           Board[]
  jsonItems        JsonItem[]
  meals            Meal[]
  recipes          Recipe[]
  foodEntries      FoodEntry[]
  alternateParents AlternateParent[]
  alternateEntries AlternateEntry[]
  ownerBridges     OwnerBridge[]
}

model Board {
  id      String @id
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  todos   Todo[]
}

model Todo {
  id      String    @id
  boardId String
  board   Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  dueAt   DateTime?
}

// Wire keys are digit strings; SQL lookups and writes use native bigint values.
model BigUser {
  id    BigInt @id
  name  String
  items BigItem[]
}

model BigItem {
  id      BigInt  @id
  ownerId BigInt
  owner   BigUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name    String
}

// Required JSON distinguishes JSON null from a forbidden SQL NULL.
model JsonItem {
  id            String @id
  ownerId       String
  owner         User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  value         Jsonb
  jsonValue     Json
  optionalValue Json?
}

// MyFit-shaped tenant references: direct User plus optional Meal and Recipe.
model Meal {
  id               String            @id
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  foodEntries      FoodEntry[]
  alternateParents AlternateParent[]
}

model Recipe {
  id          String             @id
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  foodEntries FoodEntry[]
  ingredients RecipeIngredient[]
}

model FoodEntry {
  id       String       @id
  userId   String
  user     User         @relation(fields: [userId], references: [id])
  mealId   String?
  meal     Meal?        @relation(fields: [mealId], references: [id])
  recipeId String?
  recipe   Recipe?      @relation(fields: [recipeId], references: [id])
  name     String?
  lookupId String?
  lookup   Lookup?      @relation(fields: [lookupId], references: [id])
  bridgeId String?
  bridge   OwnerBridge? @relation(fields: [bridgeId], references: [id])
}

model RecipeIngredient {
  id       String @id
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id])
}

// Either route can authorize a parent, including when the shortest is null.
model AlternateParent {
  id      String           @id
  userId  String?
  user    User?            @relation(fields: [userId], references: [id])
  mealId  String?
  meal    Meal?            @relation(fields: [mealId], references: [id])
  entries AlternateEntry[]
}

model AlternateEntry {
  id       String           @id
  userId   String?
  user     User?            @relation(fields: [userId], references: [id])
  parentId String?
  parent   AlternateParent? @relation(fields: [parentId], references: [id])
}

// Global lookup parents have no root path; server-only tenant parents do.
model Lookup {
  id      String      @id
  entries FoodEntry[]
}

model OwnerBridge {
  id      String      @id
  userId  String
  user    User        @relation(fields: [userId], references: [id])
  entries FoodEntry[]
}
